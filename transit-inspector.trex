<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="edu.stanford.realestate.transitinspector" extension-version="0.2.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Property detail panel linked to Tableau parcel map mark selection.</description>
    <author name="Real Estate Analytics" organization="Stanford Real Estate" website="https://www.stanford.edu/"/>
    <min-api-version>1.4</min-api-version>
    <source-location><url>https://YOUR_APPROVED_INTERNAL_HOST/portfolio-transit.html?mode=inspector</url></source-location>
  </dashboard-extension>
  <resources><resource id="name"><text locale="en_US">SRP Transit Fee Inspector</text></resource></resources>
</manifest>